---
interface Props {
    eyebrow: string;
    title: string;
    lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="pt-10 pb-8 sm:pt-16 sm:pb-12">
    <p class="case-eyebrow text-sm font-semibold uppercase tracking-[0.14em] text-case-eyebrow">{eyebrow}</p>
    <h1 class="mt-3 text-4xl sm:text-6xl font-bold tracking-tight text-white">{title}</h1>
    <p class="mt-5 text-lg sm:text-xl text-case-muted max-w-2xl">{lead}</p>
    <div class="mt-6 flex flex-wrap gap-2">
        <slot />
    </div>
</header>
