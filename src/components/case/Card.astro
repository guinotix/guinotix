---
interface Props {
    title?: string;
    class?: string;
}

const { title, class: extra = "" } = Astro.props;
---

<div class:list={["rounded-xl border border-case-line bg-case-surface p-5 sm:p-6", extra]}>
    {title && <h3 class="font-mono text-base font-semibold text-white mb-3">{title}</h3>}
    <slot />
</div>
