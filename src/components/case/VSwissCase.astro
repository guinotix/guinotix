---
import CaseHero from '@/components/case/CaseHero.astro';
import CaseSection from '@/components/case/CaseSection.astro';
import Card from '@/components/case/Card.astro';
import KpiCard from '@/components/case/KpiCard.astro';
import CaseFigure from '@/components/case/CaseFigure.astro';

import { vswissCopy } from '@/i18n/vswiss';
import { anaPositions, anaTopCut, anaChampion, anaAvgPosition, realPlayers } from '@/utils/vswissCase';

interface Props {
    lang: 'es' | 'en';
}

const { lang } = Astro.props;
const c = vswissCopy[lang];
const locale = lang === 'es' ? 'es-ES' : 'en-US';

const shots = {
    clasificacion: '/vswiss/01-clasificacion.webp',
    metagame: '/vswiss/02-metagame.webp',
    jugadores: '/vswiss/03-jugadores.webp',
    emparejamientos: '/vswiss/04-emparejamientos.webp',
    dashboard: '/vswiss/05-dashboard.webp',
    matriz: '/vswiss/06-matriz-matchups.webp',
    simConfig: '/vswiss/07-simulador-config.webp',
    simResultados: '/vswiss/08-simulador-resultados.webp',
    evolucion: '/vswiss/09-evolucion.webp',
    vistaJugador: '/vswiss/10-vista-jugador.webp',
    admin: '/vswiss/11-admin-arquetipos.webp',
    mazos: '/vswiss/12-mazos.webp',
    tests: '/vswiss/13-tests.png',
    simGif: '/vswiss/14-simulacion.gif',
} as const;

const figTexts: Record<keyof typeof shots, [string, string]> = lang === 'es'
    ? {
        clasificacion: ['Clasificación de un torneo en curso', 'Clasificación en curso, con puntos y desempates.'],
        metagame: ['Configuración del metagame', 'Porcentaje de cada arquetipo: a partir de aquí, los bots rellenan el campo.'],
        jugadores: ['Registro de jugadores y bots', 'Jugadores reales y bots registrados en la misma competición.'],
        emparejamientos: ['Emparejamientos de una ronda', 'Mesas de una ronda: cada jugador se empareja con un rival nuevo.'],
        dashboard: ['Dashboard de estadísticas', 'Winrates por mazo y estadísticas acumuladas.'],
        matriz: ['Matriz global de matchups', 'Matriz de matchups con los datos de las fuentes elegidas.'],
        simConfig: ['Configuración del simulador', 'Ejecuciones, fuentes de datos y semilla antes de lanzar la simulación.'],
        simResultados: ['Resultados del simulador', 'Final standings con intervalos de Wilson al 95 %.'],
        evolucion: ['Pestaña Evolution', 'Posición de cada jugador tras cada ronda.'],
        vistaJugador: ['Vista móvil del jugador', 'Emparejamiento y registro de resultado desde el móvil.'],
        admin: ['Administración de arquetipos', 'Catálogo de arquetipos y vinculación de bots con usuarios.'],
        mazos: ['Lista de cartas de un mazo', 'Lista de cartas estructurada y notas privadas.'],
        tests: ['Ejecución de la suite de tests', 'Salida de Pest: 563 tests y 3294 aserciones.'],
        simGif: ['Simulación en curso', 'Barra de progreso de una simulación en lotes de 100.'],
    }
    : {
        clasificacion: ['Standings of a tournament in progress', 'Standings in progress, with points and tiebreakers.'],
        metagame: ['Metagame configuration', 'Share of each archetype: from here on, bots fill the field.'],
        jugadores: ['Player and bot registration', 'Real players and bots registered in the same event.'],
        emparejamientos: ['Pairings for one round', 'Round tables: each player is paired with a new opponent.'],
        dashboard: ['Statistics dashboard', 'Win rates per deck and accumulated statistics.'],
        matriz: ['Global matchup matrix', 'Matchup matrix with data from the selected sources.'],
        simConfig: ['Simulator configuration', 'Runs, data sources and seed before launching the simulation.'],
        simResultados: ['Simulator results', 'Final standings with 95 % Wilson intervals.'],
        evolucion: ['Evolution tab', 'Position of each player after every round.'],
        vistaJugador: ['Player view on mobile', 'Pairing and result entry from a phone.'],
        admin: ['Archetype administration', 'Archetype catalogue and linking bots to users.'],
        mazos: ['Deck card list', 'Structured card list and private notes.'],
        tests: ['Test suite run', 'Pest output: 563 tests and 3294 assertions.'],
        simGif: ['Simulation in progress', 'Progress bar of a simulation running in batches of 100.'],
    };

const figNote = lang === 'es'
    ? 'Captura con datos de prueba: no corresponde a las cifras ilustrativas de las tablas.'
    : 'Screenshot with test data: it does not match the illustrative figures in the tables.';

const fig = (k: keyof typeof shots) => ({
    src: shots[k],
    alt: figTexts[k][0],
    caption: figTexts[k][1],
    note: k === 'tests' ? '' : figNote,
});

const fmt = (n: number) => n.toLocaleString(locale, { maximumFractionDigits: 1 });
const pct = (n: number) => (lang === 'es' ? `${fmt(n)} %` : `${fmt(n)}%`);

const faded = [[1, 3], [3, 1]];
const cellTone = (v: number | null) => {
    if (v === null) return 'bg-case-surface';
    if (v >= 55) return 'bg-case-green/25';
    if (v <= 45) return 'bg-case-rose/20';
    return 'bg-case-surface';
};
const isFaded = (r: number, col: number) => faded.some(([a, b]) => a === r && b === col);

const th = "text-left font-mono text-xs uppercase tracking-wider text-case-muted py-2 pr-4 border-b border-case-line";
const td = "py-2 pr-4 border-b border-case-line align-top";
---

<article class="case-study w-full max-w-3xl mx-auto px-4 sm:px-0 pb-16 text-left">

    <CaseHero eyebrow={c.eyebrow} title={c.title} lead={c.lead}>
        {c.chips.map((chip) => (
            <span class="rounded-full bg-case-accent-soft px-3 py-1 text-xs font-semibold text-case-accent-text">{chip}</span>
        ))}
    </CaseHero>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {c.kpis.map((k) => <KpiCard value={k.value} label={k.label} />)}
    </div>

    <!-- 01 · Contexto -->
    <CaseSection id="problema" eyebrow={c.problem.eyebrow} title={c.problem.title}>
        <p>{c.problem.body}</p>
        <div class="grid gap-3 sm:grid-cols-3">
            {c.problem.pains.map((p) => (
                <Card title={p.t}><p class="text-sm text-case-muted">{p.d}</p></Card>
            ))}
        </div>

        <div class="pt-2">
            <p class="case-eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-case-eyebrow">{c.solution.eyebrow}</p>
            <h3 class="mt-2 font-mono text-lg font-semibold text-white">{c.solution.title}</h3>
            <div class="mt-4 grid gap-6 sm:grid-cols-2">
                <ul class="space-y-3 text-sm">
                    {c.solution.colA.map((i) => <li><b class="text-white">{i.b}</b> {i.t}</li>)}
                </ul>
                <ul class="space-y-3 text-sm">
                    {c.solution.colB.map((i) => <li><b class="text-white">{i.b}</b> {i.t}</li>)}
                </ul>
            </div>
        </div>

        <div class="pt-2">
            <p class="case-eyebrow text-xs font-semibold uppercase tracking-[0.14em] text-case-eyebrow">{c.users.eyebrow}</p>
            <div class="mt-4 grid gap-3 sm:grid-cols-3">
                {c.users.items.map((u) => (
                    <Card title={u.t}><p class="text-sm text-case-muted">{u.d}</p></Card>
                ))}
            </div>
        </div>

        <div>
            <h3 class="font-mono text-base font-semibold text-white mb-3">{c.users.flowTitle}</h3>
            <ol class="grid grid-cols-2 sm:grid-cols-6 gap-2">
                {c.users.flow.map((s, i) => (
                    <li class={`rounded-xl border p-3 ${i === c.users.flow.length - 1 ? 'border-case-accent bg-case-accent text-white' : 'border-case-line bg-case-surface'}`}>
                        <p class="font-mono text-sm font-semibold text-white">{s.t}</p>
                        <p class={`text-xs ${i === c.users.flow.length - 1 ? 'text-violet-100' : 'text-case-muted'}`}>{s.s}</p>
                    </li>
                ))}
            </ol>
        </div>

        <div class="grid gap-8">
            <CaseFigure {...fig('metagame')} />
            <CaseFigure {...fig('jugadores')} />
            <CaseFigure {...fig('mazos')} />
            <CaseFigure {...fig('dashboard')} />
            <CaseFigure {...fig('admin')} />
        </div>
    </CaseSection>

    <!-- 04 · Arquitectura -->
    <CaseSection id="arquitectura" eyebrow={c.architecture.eyebrow} title={c.architecture.title}>
        <p>{c.architecture.body}</p>

        <div class="grid gap-4 md:grid-cols-[1fr_2fr]">
            <div class="rounded-xl border border-case-accent/40 bg-case-accent-soft p-4">
                <p class="font-mono text-sm font-semibold text-case-accent-text mb-3">{c.architecture.browserLabel}</p>
                <ul class="space-y-2">
                    {c.architecture.browser.map((b) => <li class="rounded-lg border border-case-line bg-case-surface px-3 py-2 text-sm text-white">{b}</li>)}
                </ul>
            </div>
            <div class="rounded-xl border border-case-line bg-case-surface p-4 space-y-3">
                <p class="font-mono text-sm font-semibold text-white">{c.architecture.serverLabel}</p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                    {c.architecture.server.map((s) => <div class="rounded-lg border border-case-line px-2 py-2 text-center text-xs text-white">{s}</div>)}
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    {c.architecture.layers.map((l) => (
                        <div class="rounded-lg border border-case-accent/40 bg-case-accent-soft px-2 py-2 text-center">
                            <p class="font-mono text-xs font-semibold text-case-accent-text">{l.t}</p>
                            <p class="text-[11px] text-case-muted">{l.s}</p>
                        </div>
                    ))}
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <div class="rounded-lg border border-case-teal/40 bg-case-teal/10 px-3 py-2 text-center">
                        <p class="font-mono text-xs font-semibold text-case-teal">{c.architecture.engine.t}</p>
                        <p class="text-[11px] text-case-muted">{c.architecture.engine.s}</p>
                    </div>
                    <div class="rounded-lg border border-case-teal/40 bg-case-teal/10 px-3 py-2 text-center">
                        <p class="font-mono text-xs font-semibold text-case-teal">{c.architecture.job.t}</p>
                        <p class="text-[11px] text-case-muted">{c.architecture.job.s}</p>
                    </div>
                    <div class="rounded-lg border border-case-amber/40 bg-case-amber/10 px-3 py-2 text-center">
                        <p class="font-mono text-xs font-semibold text-case-amber">{c.architecture.data.t}</p>
                    </div>
                    <div class="rounded-lg border border-case-amber/40 bg-case-amber/10 px-3 py-2 text-center">
                        <p class="font-mono text-xs font-semibold text-case-amber">{c.architecture.infra.t}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
            <Card title={c.architecture.stackTitle}>
                <table class="w-full text-sm">
                    <tbody>
                        {c.architecture.stack.map(([k, v]) => (
                            <tr><td class={`${td} font-semibold text-white whitespace-nowrap`}>{k}</td><td class={td}>{v}</td></tr>
                        ))}
                    </tbody>
                </table>
            </Card>
            <Card title={c.architecture.decisionsTitle}>
                <ul class="list-disc pl-5 space-y-1.5 text-sm text-case-muted">
                    {c.architecture.decisions.map((d) => <li>{d}</li>)}
                </ul>
            </Card>
        </div>

        <div>
            <h3 class="font-mono text-base font-semibold text-white mb-3">{c.architecture.lifecycleTitle}</h3>
            <div class="rounded-xl border border-case-line bg-case-surface p-4 sm:p-6">
                <ol class="flex w-full flex-col items-stretch md:flex-row md:items-center">
                    {c.architecture.lifecycle.map((s, i) => {
                        const last = c.architecture.lifecycle.length - 1;
                        const tone = i === last
                            ? 'border-case-accent bg-case-accent text-white'
                            : i >= 2 && i <= 3
                                ? 'border-case-accent/50 bg-case-accent-soft text-case-accent-text'
                                : 'border-case-line bg-case-surface-strong text-white';
                        return (
                            <>
                                <li class={`rounded-xl border px-3 py-3 text-center font-mono text-sm font-semibold md:flex-1 md:min-w-0 md:px-2 md:text-xs ${tone}`}>
                                    {s}
                                </li>
                                {i < last && (
                                    <li aria-hidden="true" class="flex flex-col items-center justify-center gap-0.5 py-2 md:w-14 md:shrink-0 md:py-0">
                                        <span class="font-mono text-[10px] text-case-muted whitespace-nowrap">{c.architecture.lifecycleActions[i]}</span>
                                        <span class="text-lg leading-none text-case-accent-text md:hidden">↓</span>
                                        <span class="hidden text-lg leading-none text-case-accent-text md:block">→</span>
                                    </li>
                                )}
                            </>
                        );
                    })}
                </ol>
                <div class="mt-5 flex items-center gap-3 text-xs text-case-muted">
                    <span class="rounded-full border border-dashed border-case-accent-text px-3 py-1 font-mono text-case-accent-text whitespace-nowrap">{c.architecture.lifecycle[2]} → {c.architecture.lifecycle[4]}</span>
                    <span>{c.architecture.lifecycleSkip}</span>
                </div>
            </div>
        </div>
    </CaseSection>

    <!-- 05 · Motor suizo -->
    <CaseSection id="motor" eyebrow={c.engine.eyebrow} title={c.engine.title}>
        <p>{c.engine.body}</p>
        <CaseFigure {...fig('clasificacion')} />

        <div class="grid gap-3 md:grid-cols-2">
            <Card title={c.engine.rulesTitle}>
                <ul class="space-y-2 text-sm">
                    {c.engine.rules.map((r) => <li><b class="text-white">{r.b}</b> {r.t}</li>)}
                </ul>
            </Card>
            <div class="grid gap-3">
                <Card title={c.engine.scoringTitle}>
                    <table class="w-full text-sm">
                        <tbody>
                            {c.engine.scoring.map(([k, v]) => (
                                <tr><td class={td}>{k}</td><td class={`${td} text-right font-mono text-case-accent-text`}>{v}</td></tr>
                            ))}
                        </tbody>
                    </table>
                </Card>
                <Card title={c.engine.roundsTitle}>
                    <table class="w-full text-sm">
                        <thead>
                            <tr>{c.engine.roundsHead.map((h, i) => <th class={`${th} ${i > 0 ? 'text-right' : ''}`}>{h}</th>)}</tr>
                        </thead>
                        <tbody>
                            {c.engine.rounds.map(([a, b, d]) => (
                                <tr><td class={td}>{a}</td><td class={`${td} text-right`}>{b}</td><td class={`${td} text-right`}>{d}</td></tr>
                            ))}
                        </tbody>
                    </table>
                    <p class="mt-2 text-xs text-case-muted">{c.engine.roundsNote}</p>
                </Card>
            </div>
        </div>

        <Card title={c.engine.tiebreakTitle}>
            <ul class="space-y-2 text-sm">
                {c.engine.tiebreaks.map((t) => <li><b class="text-white">{t.b}</b> {t.t}</li>)}
            </ul>
        </Card>

        <div>
            <h3 class="font-mono text-base font-semibold text-white mb-3">{c.engine.exampleTitle}</h3>
            <div class="grid gap-3 md:grid-cols-2">
                <Card title={c.engine.exampleLeft}>
                    <ul class="space-y-1 text-sm font-mono">
                        {c.engine.exampleStandings.map(([p, pts]) => (
                            <li class="flex justify-between border-b border-case-line py-1">
                                <span class="text-white">{p}</span>
                                <span class={pts.startsWith('3') ? 'text-case-accent-text' : 'text-case-muted'}>{pts}</span>
                            </li>
                        ))}
                    </ul>
                </Card>
                <Card title={c.engine.exampleRight}>
                    <ul class="space-y-2 text-sm">
                        {c.engine.examplePairs.map(([m, why]) => (
                            <li class="rounded-lg border border-case-line bg-case-surface px-3 py-2">
                                <p class="font-mono font-semibold text-white">{m}</p>
                                <p class="text-xs text-case-muted">{why}</p>
                            </li>
                        ))}
                    </ul>
                </Card>
            </div>
            <p class="mt-3 text-xs italic text-case-muted">{c.engine.exampleNote}</p>
            <div class="mt-6">
                <CaseFigure {...fig('emparejamientos')} />
            </div>
        </div>
    </CaseSection>

    <!-- 06 · Bots -->
    <CaseSection id="bots" eyebrow={c.bots.eyebrow} title={c.bots.title}>
        <p>{c.bots.body}</p>

        <div class="grid gap-4 md:grid-cols-2">
            <div>
                <h3 class="font-mono text-base font-semibold text-white mb-3">{c.bots.formulaTitle}</h3>
                <pre class="font-mono text-sm overflow-x-auto rounded-xl border border-case-line bg-black/30 p-4 text-violet-100 leading-relaxed">{c.bots.formula}</pre>
                <p class="mt-3 text-sm text-case-muted">{c.bots.formulaNote}</p>
                <ul class="mt-3 space-y-2 text-sm">
                    {c.bots.formulaBullets.map((b) => <li><b class="text-white">{b.b}</b> {b.t}</li>)}
                </ul>
            </div>
            <Card title={c.bots.winTitle}>
                <p class="text-sm text-case-muted mb-4">{c.bots.winLead}</p>
                <div class="flex h-44 items-end gap-4 border-b border-case-line pb-1">
                    {c.bots.winBars.map(([games, p]) => (
                        <div class="flex flex-1 flex-col items-center justify-end h-full">
                            <span class="mb-1 font-mono text-sm font-semibold text-white">{p}%</span>
                            <div class="w-full rounded-t-md bg-case-accent" style={`height:${p}%`}></div>
                        </div>
                    ))}
                </div>
                <div class="mt-2 flex gap-4 text-center text-xs text-case-muted">
                    {c.bots.winBars.map(([games]) => <span class="flex-1">{games}</span>)}
                </div>
                <p class="mt-2 text-center text-xs text-case-muted">{c.bots.winXLabel}</p>
            </Card>
        </div>

        <div>
            <h3 class="font-mono text-base font-semibold text-white mb-3">{c.bots.matrixTitle}</h3>
            <div class="overflow-x-auto">
                <table class="w-full min-w-105 text-sm text-center border-separate border-spacing-1">
                    <thead>
                        <tr>
                            <th class="p-2"></th>
                            {c.bots.matrixLabels.map((l) => <th class="p-2 font-mono text-xs text-case-muted">{l}</th>)}
                        </tr>
                    </thead>
                    <tbody>
                        {c.bots.matrix.map((row, r) => (
                            <tr>
                                <th class="p-2 text-left font-mono text-xs text-white whitespace-nowrap">{c.bots.matrixLabels[r]}</th>
                                {row.map((v, col) => (
                                    <td class={`rounded-md p-2 font-semibold text-white ${cellTone(v)} ${isFaded(r, col) ? 'opacity-50' : ''}`}>
                                        {v === null ? '—' : pct(v)}
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <p class="mt-2 text-xs italic text-case-muted">{c.bots.matrixNote}</p>
            <div class="mt-4">
                <CaseFigure {...fig('matriz')} />
            </div>
        </div>

        <Card title={c.bots.limitsTitle}>
            <ul class="list-disc pl-5 space-y-1.5 text-sm text-case-muted">
                {c.bots.limits.map((l) => <li>{l}</li>)}
            </ul>
        </Card>
    </CaseSection>

    <!-- 07 · Simulador -->
    <CaseSection id="simulador" eyebrow={c.simulator.eyebrow} title={c.simulator.title}>
        <p>{c.simulator.body}</p>

        <ol class="grid gap-2 sm:grid-cols-5">
            {c.simulator.pipeline.map((s, i) => (
                <li class={`rounded-xl border p-3 ${i === c.simulator.pipeline.length - 1 ? 'border-case-accent bg-case-accent text-white' : 'border-case-line bg-case-surface'}`}>
                    <p class="font-mono text-sm font-semibold text-white">{s.t}</p>
                    <p class={`text-xs ${i === c.simulator.pipeline.length - 1 ? 'text-violet-100' : 'text-case-muted'}`}>{s.s}</p>
                </li>
            ))}
        </ol>

        <div class="grid gap-3 md:grid-cols-2">
            <Card title={c.simulator.eachTitle}>
                <ol class="list-decimal pl-5 space-y-1.5 text-sm text-case-muted">
                    {c.simulator.each.map((e) => <li>{e}</li>)}
                </ol>
            </Card>
            <Card title={c.simulator.paramsTitle}>
                <table class="w-full text-sm">
                    <tbody>
                        {c.simulator.params.map(([k, v]) => (
                            <tr><td class={td}>{k}</td><td class={`${td} text-right font-mono text-case-accent-text`}>{v}</td></tr>
                        ))}
                    </tbody>
                </table>
                <p class="mt-2 text-xs text-case-muted">{c.simulator.perfNote}</p>
            </Card>
        </div>

        <CaseFigure {...fig('simConfig')} />

        <div>
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <h3 class="font-mono text-base font-semibold text-white">{c.simulator.realTitle}</h3>
                <span class="rounded-full bg-case-amber/15 px-2 py-0.5 text-[11px] font-semibold text-case-amber">{c.simulator.tag}</span>
            </div>
            <div class="overflow-x-auto rounded-xl border border-case-line bg-case-surface p-3">
                <table class="w-full min-w-130 text-sm">
                    <thead>
                        <tr>{c.simulator.realHead.map((h, i) => <th class={`${th} ${i >= 2 && i <= 4 ? 'text-right' : ''}`}>{h}</th>)}</tr>
                    </thead>
                    <tbody>
                        {realPlayers.map((p) => (
                            <tr>
                                <td class={`${td} font-semibold text-white`}>{p.name}</td>
                                <td class={td}>{p.deck}</td>
                                <td class={`${td} text-right font-mono`}>{pct(p.topCut)}</td>
                                <td class={`${td} text-right font-mono`}>{pct(p.champion)}</td>
                                <td class={`${td} text-right font-mono`}>{p.avgPosition}</td>
                                <td class={`${td} font-mono`}>{p.record.map((r) => fmt(r)).join(' – ')}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>

        <CaseFigure {...fig('simResultados')} />

        <div>
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <h3 class="font-mono text-base font-semibold text-white">{c.simulator.placementsTitle}</h3>
                <span class="rounded-full bg-case-amber/15 px-2 py-0.5 text-[11px] font-semibold text-case-amber">{c.simulator.tag}</span>
            </div>
            <ul class="space-y-2">
                {anaPositions.map((p, i) => (
                    <li class="grid grid-cols-[6.5rem_1fr_3.5rem] items-center gap-3 text-sm">
                        <span class="text-case-muted font-mono text-xs">{p.label}</span>
                        <div class="h-5 rounded bg-case-surface">
                            <div class={`h-5 rounded ${i < 4 ? 'bg-case-accent' : 'bg-case-data-3/70'}`} style={`width:${(p.value / 40) * 100}%`}></div>
                        </div>
                        <span class="text-right font-mono text-white">{pct(p.value)}</span>
                    </li>
                ))}
            </ul>
            <p class="mt-3 text-xs text-case-muted">
                {lang === 'es'
                    ? `Top cut ${pct(anaTopCut)} (1.º–8.º) · Campeón ${pct(anaChampion)} · Posición media ${anaAvgPosition}.`
                    : `Top cut ${pct(anaTopCut)} (1st–8th) · Champion ${pct(anaChampion)} · Average position ${anaAvgPosition}.`}
            </p>
        </div>

        <div>
            <h3 class="font-mono text-base font-semibold text-white mb-3">{c.simulator.tabsTitle}</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {c.simulator.tabs.map((t) => (
                    <Card><p class="font-mono text-sm font-semibold text-white">{t.t}</p><p class="mt-1 text-sm text-case-muted">{t.d}</p></Card>
                ))}
            </div>
        </div>

        <div class="grid gap-8">
            <CaseFigure {...fig('evolucion')} />
        </div>
    </CaseSection>

    <!-- 08 · Calidad -->
    <CaseSection id="calidad" eyebrow={c.quality.eyebrow} title={c.quality.title}>
        <ul class="list-disc pl-5 space-y-2 text-sm">
            {c.quality.items.map((i) => <li><b class="text-white">{i.b}</b> {i.t}</li>)}
        </ul>
        <div class="grid grid-cols-2 gap-3 sm:gap-4 max-w-md">
            {c.quality.kpis.map((k) => <KpiCard value={k.value} label={k.label} />)}
        </div>
        <CaseFigure {...fig('tests')} />
        <!-- <p class="text-xs text-case-muted">{c.quality.note}</p> -->
    </CaseSection>

    <!-- 09 · Retos -->
    <CaseSection id="retos" eyebrow={c.lessons.eyebrow} title={c.lessons.title}>
        <div class="overflow-x-auto">
            <table class="w-full min-w-120 text-sm">
                <thead>
                    <tr><th class={`${th} w-[30%]`}>{c.lessons.head[0]}</th><th class={th}>{c.lessons.head[1]}</th></tr>
                </thead>
                <tbody>
                    {c.lessons.rows.map((r) => (
                        <tr><td class={`${td} font-semibold text-white`}>{r.t}</td><td class={`${td} text-case-muted`}>{r.d}</td></tr>
                    ))}
                </tbody>
            </table>
        </div>
        <!-- <p class="text-sm"><b class="text-white">{c.lessons.learningLabel}</b> {c.lessons.learning}</p> -->
    </CaseSection>

    <!-- 10 · Estado -->
    <CaseSection id="estado" eyebrow={c.status.eyebrow} title={c.status.stateTitle}>
        <div class="grid gap-3 md:grid-cols-2">
            <Card><p class="text-sm text-case-muted">{c.status.state}</p></Card>
            <Card title={c.status.nextTitle}>
                <ul class="list-disc pl-5 space-y-1.5 text-sm text-case-muted">
                    {c.status.next.map((n) => <li>{n}</li>)}
                </ul>
            </Card>
        </div>
        <a href={`/${lang}#projects`} class="inline-flex text-sm text-case-accent-text hover:underline">← {c.footer}</a>
    </CaseSection>

</article>
