---
import Icon from '@/components/ui/Icon.astro';
import AvailabilityBadge from '@/components/ui/AvailabilityBadge.astro';
import { name, role, contact } from '@/utils/hero';
---

<div class="grid grid-cols-1 sm:grid-cols-2 place-items-center justify-center min-h-screen">
    <div class="flex flex-col items-center justify-center my-12 p-2">
	    <div class="text-4xl sm:text-5xl font-semibold">
            {name[0]}<br>{name[1]}
        </div>
	    <div class="my-4 space-y-2">
            <p>{role[0]}</p>
            <p>{role[1]}</p>
        </div>
	    <div class="space-x-6">
            {contact.map((c) => (
                <a aria-label={c.via} href={c.link} target="_blank" class="group inline-flex items-center hover:text-white focus:outline-2 focus:rounded-sm focus:outline-violet-500">
	    	        <Icon name={c.via} />
	    	    </a>
            ))}
	    </div>
        <AvailabilityBadge currentStatus={'unavailable'} />
    </div>
    <section class="p-6">
        <img src="/face.webp" alt="profile" class="block w-72 h-72 rounded-2xl -rotate-6">
    </section>
</div>
