---
import CardTech from '@/components/ui/CardTech.astro';
import Logo from '@/components/ui/Logo.astro';
import { myTechs } from '@/utils/techs';
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 mt-4">
    {myTechs.map((tech) => (
        <CardTech technology={tech.name} main={tech.isMain}>
            <Logo name={tech.name} />
        </CardTech>
    ))}
</div>
